# Bases
##################################
## Vermillion and Cerulean Ring ##
##################################

Show
	BaseType == "Cerulean Ring"
	Corrupted False
	Mirrored False
	ItemLevel >= 85 # t1 mana
	SetFontSize 45
	SetTextColor 0 0 255 255
	#!BrightBackground!# 255
	#!TopBaseBorder!# 222
	MinimapIcon 0 Blue Star
	PlayEffect Blue
	CustomAlertSound "sounds/d2-necromancer-death-1.mp3" 300

Show
	BaseType == "Vermillion Ring"
	Corrupted False
	Mirrored False
	ItemLevel >= 84 # t1 resists
	SetFontSize 45
	SetTextColor 0 0 255 255
	#!BrightBackground!# 255
	#!TopBaseBorder!# 222
	MinimapIcon 0 Blue Star
	PlayEffect Blue
	CustomAlertSound "sounds/d2-necromancer-death-1.mp3" 300

Show # Influenced Rings
	HasInfluence Crusader Hunter Redeemer Warlord
	BaseType "Ring"
	ItemLevel >= 75
	Rarity <= Rare
	Corrupted False
	Mirrored False
	SetFontSize 45
	#!GoodBaseBorder!# 200
	SetTextColor 100 0 122 255
	PlayEffect Cyan
	PlayAlertSound 1 300
	MinimapIcon 1 Cyan Cross

########################
## Top Utility Flasks ##
########################
Show
	Class == "Utility Flasks"
	ItemLevel >= 85 # t1 move speed
	SetFontSize 45
	Rarity <= Magic
	SetTextColor 0 203 221 200
	PlayEffect Red
	SetBorderColor 255 0 0 200

## Flagellant
Show
	Class == "Utility Flasks"
	ItemLevel >= 80 # Best Flagellant Chance
	ItemLevel <= 81 # includes a tier of resists during flask effect
	SetFontSize 45
	Rarity <= Magic
	SetTextColor 0 203 221 200
	SetBorderColor 255 255 0 200
	PlayEffect Red

##############
## T1 Bases ##
##############
Show
	ItemLevel >= 85
	Rarity <= Rare
	BaseDefencePercentile >= 100
	Corrupted False
	Mirrored False
	Class == "Helmets" "Gloves" "Boots"
	DropLevel >= 84
	#!TopBaseBorder!# 222
	SetBackgroundColor 200 255 255 230
	SetFontSize 45
	PlayEffect Red
	MinimapIcon 1 Yellow Star
	PlayAlertSound 3 200

Show
	ItemLevel >= 86
	Rarity <= Rare
	Corrupted False
	Mirrored False
	Class == "Body Armour"
	DropLevel >= 84
	#!TopBaseBorder!# 222
	SetBackgroundColor 200 255 255 230
	SetFontSize 45
	PlayEffect Red
	MinimapIcon 1 Yellow Star
	PlayAlertSound 3 200

