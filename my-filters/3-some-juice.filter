Show
	Rarity Rare
	BaseType == "Cobalt Jewel" "Crimson Jewel" "Viridian Jewel"
	SetFontSize 45
	SetBorderColor 0 220 220 255
	PlayEffect Grey
	MinimapIcon 2 Grey Diamond

Show
	BaseType == "Syndicate Medallion"
	SetFontSize 45
	SetTextColor 180 0 255 255
	SetBorderColor 180 0 255 255
	SetBackgroundColor 255 255 255 255
	PlayEffect Red
	MinimapIcon 0 Red Star
	CustomAlertSound "sounds/glarses-manly-scream.mp3"

Show
	Identified True
	HasExplicitMod = "Haku's"
	SetFontSize 45
	SetTextColor 177 159 255 200
	SetBorderColor 177 159 255 200
	SetBackgroundColor 255 255 255 255
	PlayEffect Purple
	CustomAlertSound "sounds/glarses-manly-scream.mp3"

Show
	StackSize < 3
	Class == "Stackable Currency"
	BaseType == "Simulacrum Splinter"
	SetFontSize 40
	SetTextColor 255 255 255 255
	SetBorderColor 130 15 255 255
	SetBackgroundColor 65 20 80

Show
	BaseType "Scroll of Wisdom"
	StackSize >= 8
	#!ScrollOfWisdomText!# 220
	#!GGGCurrencyBorder!# 255

Show
	BaseType "Portal Scroll"
	StackSize >= 8
	#!PortalScrollText!# 255
	#!GGGCurrencyBorder!# 255

Show
	BaseType == "Sacrifice at Midnight" "Sacrifice at Noon"
	SetFontSize 45
	SetTextColor 175 120 230 240
	SetBorderColor 175 120 230 240
	SetBackgroundColor 65 20 80

Show
	BaseType == "Sacrifice at Dusk" "Sacrifice at Dawn"
	StackSize >= 2
	SetFontSize 40
	SetTextColor 175 120 230 240
	SetBorderColor 175 120 230 240
	# SetBackgroundColor 65 20 80

Show
	Class == "Stackable Currency"
	BaseType == "Aberrant Fossil" "Aetheric Fossil" "Bloodstained Fossil" "Bound Fossil" "Deft Fossil" "Dense Fossil" "Frigid Fossil" "Gilded Fossil" "Jagged Fossil" "Lucent Fossil" "Metallic Fossil" "Opulent Fossil" "Prismatic Fossil" "Pristine Fossil" "Scorched Fossil" "Serrated Fossil"
	SetFontSize 45
