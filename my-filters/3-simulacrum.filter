#! import 3.29-allflame-specific.filter

Show # gold drops last in simulacrums so when you see gold, that's all the items.
	Class "Gold"
	SetFontSize 45
	SetBorderColor 255 0 255 255
	SetBackgroundColor 0 0 0 255
	SetTextColor 255 0 255 255

Show
	BaseType "Portal Scroll"
	#!PortalScrollText!# 255
	#!GGGCurrencyBorder!# 255
	SetBackgroundColor 0 0 0 200
	SetFontSize 40

Show # Mapping Currency
	Class "Currency"
	BaseType == "Orb of Scouring"
	SetFontSize 45
	#!T1CurrencyText!# 255
	#!CurrencyBorder!# 255
	MinimapIcon 0 Orange Circle
	PlayEffect Pink
	PlayAlertSound 11 200

