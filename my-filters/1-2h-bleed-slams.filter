Show
	BaseType = "Blood Sap Tincture"
	Rarity <= Rare
	SetFontSize 45
	#!GoodBaseBorder!# 200
	MinimapIcon 2 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/neon-what-the-heck.mp3" 300

Show
	BaseType == "Granite Flask"
	SetFontSize 45
	Rarity <= Magic
	#!WhiteText!# 255
	SetBorderColor 255 255 0 200
	PlayEffect Yellow
	MinimapIcon 0 Grey UpsideDownHouse
	CustomAlertSound "sounds/gamersnexus-thanks-intel.mp3"

Show
	AreaLevel < 29 # The Ebony Barracks: Phys craft is unlocked
	BaseType "Rustic Sash"
	SetFontSize 45
	SetTextColor 255 0 0 255
	SetBorderColor 255 255 0 200
	PlayEffect Yellow
	MinimapIcon 0 Grey UpsideDownHouse
	CustomAlertSound "sounds/gamersnexus-thanks-intel.mp3"

# More Leveling Items
Show
	BaseType = "Lapis Amulet"
	AreaLevel <= 7
	#!LevelingBorder!# 230
	#!BrightBackground!# 255
	MinimapIcon 1 Pink Star
	#! tts "lapis" lapis-amulet Amy 200 1.0

Show
	BaseType "Heavy Belt"
	AreaLevel < 30
	Rarity <= Rare
	SetFontSize 45
	MinimapIcon 1 Cyan Star
	#!BrightBorder!# 200
	#! tts "heavy belt" heavy-belt Amy 200 1.0

# Rares during leveling
Show
	AreaLevel <= 72 # Tier 5
	Rarity = Rare
	Corrupted False
	Mirrored False
	BaseType #!str2!#
	SetFontSize 45
	PlayEffect Yellow
	MinimapIcon 1 Yellow Star

Show
	AreaLevel < 72 # Tier 5
	Rarity = Rare
	Corrupted False
	Mirrored False
	BaseType #!strinthelm2!# #!strintboots!#
	SetBorderColor 53 216 234 255
	SetFontSize 45
	PlayEffect Yellow
	MinimapIcon 1 Yellow Star

