Show
	BaseType = "Prismatic Tincture" "Rosethorn Tincture"
	Rarity <= Rare
	SetFontSize 45
	#!GoodBaseBorder!# 200
	MinimapIcon 2 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/neon-what-the-heck.mp3" 300

Show
	BaseType == "Granite Flask"
	SetFontSize 45
	Rarity <= Magic
	#!WhiteText!# 255
	SetBorderColor 255 255 0 200
	PlayEffect Yellow
	MinimapIcon 0 Grey UpsideDownHouse
	CustomAlertSound "sounds/gamersnexus-thanks-intel.mp3"

Show
	AreaLevel <= 70
	BaseType "Rustic Sash"
	SetFontSize 45
	SetTextColor 255 0 0 255
	SetBorderColor 255 255 0 200
	PlayEffect Yellow
	MinimapIcon 0 Grey UpsideDownHouse
	CustomAlertSound "sounds/gamersnexus-thanks-intel.mp3"

Show
	AreaLevel <= 55
	Class "Currency"
	BaseType "Blacksmith's Whetstone"
	SetFontSize 45
	#!T3CurrencyText!# 230
	SetBorderColor 255 255 0 200
	PlayEffect Yellow
	MinimapIcon 0 Grey UpsideDownHouse
	#! tts "blacksmith" blacksmith Amy 200 1.0

Show
	AreaLevel <= 36
	Class "One Hand" "Two Hand" "Wand" "Sceptre" "Dagger" "Bow" "Staves" "Dagger" "Claw"
	Quality >= 20
	SetFontSize 45
	#!T3CurrencyText!# 230
	SetBorderColor 255 255 0 200
	PlayEffect Yellow
	MinimapIcon 0 Grey UpsideDownHouse
	#! tts "20 quality weapon" 20-quality-weapon Amy 200 1.0

