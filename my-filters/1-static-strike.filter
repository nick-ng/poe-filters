# Item Bases
Show
	BaseType = "Reaver Axe"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	ItemLevel = 83 # T1 Phys, T1 Cast Speed
	SetFontSize 45
	#!GoodBaseBorder!# 200
	MinimapIcon 0 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/ben-finegold-this-is-serious.mp3"

Show
	BaseType = "Reaver Axe"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	ItemLevel >= 83 # T1 Phys
	SetFontSize 40
	#!GoodBaseBorder!# 200
	MinimapIcon 1 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/neon-uh-sure-1.mp3" 300

Show
	BaseType = "Reaver Axe"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	AreaLevel < 81
	ItemLevel >= 73 # T2 Phys
	SetFontSize 35
	#!GoodBaseBorder!# 200
	MinimapIcon 2 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/neon-uh-sure-1.mp3" 300

Show
	BaseType = "Reaver Axe"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	ItemLevel >= 65 # T2 Phys
	SetFontSize 30
	#!GoodBaseBorder!# 200
	MinimapIcon 2 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/neon-uh-sure-1.mp3" 300

Show
	Class == "Gloves"
	DropLevel >= 57
	Rarity <= Rare
	SetFontSize 45
	BaseArmour >= 1
	BaseEnergyShield == 0
	#!GoodBaseBorder!# 200
	DisableDropSound
	MinimapIcon 0 Cyan Triangle
	CustomAlertSound "sounds/glarses-manly-scream.mp3" 300

Show
	Class == "Helmets"
	DropLevel >= 58
	Corrupted False
	Mirrored False
