# Item Bases
Show
	BaseType = "Reaver Axe"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	ItemLevel = 83 # T1 Phys, T1 Cast Speed
	SetFontSize 45
	#!GoodBaseBorder!# 200
	MinimapIcon 0 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/ben-finegold-this-is-serious.mp3"

Show
	BaseType = "Reaver Axe"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	ItemLevel >= 83 # T1 Phys
	SetFontSize 40
	#!GoodBaseBorder!# 200
	MinimapIcon 1 Pink Star

Show
	BaseType = "Reaver Axe"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	AreaLevel < 81
	ItemLevel >= 77 # T1 Flat
	SetFontSize 35
	#!GoodBaseBorder!# 200
	MinimapIcon 2 Pink Star

