Show
	Class == "Body Armours"
	DropLevel >= 56
	LinkedSockets >= 5
	Rarity <= Rare
	SetFontSize 45
	BaseArmour >= 1
	BaseEnergyShield == 0
	#!GoodBaseBorder!# 200
	DisableDropSound
	MinimapIcon 0 Cyan Pentagon
