Show
	Class == "Boots"
	DropLevel >= 58
	Corrupted False
	Mirrored False
	Rarity <= Rare
	SetFontSize 45
	BaseArmour >= 1
	BaseEnergyShield == 0
	#!GoodBaseBorder!# 200
	DisableDropSound
	MinimapIcon 0 Cyan Square
	CustomAlertSound "sounds/glarses-manly-scream.mp3" 300

Show
	Class == "Shields"
	DropLevel >= 58
	Corrupted False
	Mirrored False
	Rarity <= Rare
	SetFontSize 45
	BaseArmour >= 1
	BaseEnergyShield == 0
	#!GoodBaseBorder!# 200
