Show
	BaseType == "Jewelled Foil"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	ItemLevel >= 82 # T1 Phys, T1 Cast Speed
	SetFontSize 45
	#!GoodBaseBorder!# 200
	MinimapIcon 0 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/ben-finegold-this-is-serious.mp3"

Show
	BaseType == "Unset Ring"
	Corrupted False
	Mirrored False
	Rarity <= Rare
	ItemLevel >= 84 # T1 Phys, T1 Cast Speed
	SetFontSize 45
	#!GoodBaseBorder!# 200
	MinimapIcon 0 Pink Star
	PlayEffect Brown
	CustomAlertSound "sounds/ben-finegold-this-is-serious.mp3"
